{
  "manifest_version": 3,
  "name": "Web Penguins — xpenguins + xsnow",
  "version": "0.1.0",
  "description": "The 1999 desktop classics on every page: penguins walk on your DOM and snow settles on your elements. Original pixel art.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["webpenguins.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-penguins@webpenguins.local",
      "strict_min_version": "121.0"
    }
  }
}
